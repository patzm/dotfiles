[user]
    email = martin@patz.family
    name = Martin Patz

[credential]
    helper = cache --timeout 36000

[pull]
    ff = only

[push]
    default = simple
    autoSetupRemote = True

[merge]
    tool = meld

[remote "origin"]
    prune = True

[core]
    excludesfile = ~/.gitignore

[filter "lfs"]
    clean = git-lfs clean -- %f
    smudge = git-lfs smudge -- %f
    process = git-lfs filter-process
    required = true

[fetch]
	prune = true

[submodule]
    recurse = true
