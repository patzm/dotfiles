# Fix injecting invalid LC_CTYPE=UTF-8
if [[ "$LC_CTYPE" == "UTF-8" ]]; then
    unset LC_CTYPE
fi

export LC_CTYPE="C.UTF-8"
export LC_ALL="C.UTF-8"

# Configure neovim for common tasks
export EDITOR="nvim"
export VISUAL="nvim"

# tmux
export TMUX_CONFIG_PATH="$HOME/{{ .tmuxRelConfigPath }}"
export TMUX_PLUGIN_MANAGER_PATH="$HOME/{{ .tmuxRelPluginPath }}"

# Git commit identity from global git config (single source of truth)
export GIT_AUTHOR_NAME="$(git config --global --get user.name)"
export GIT_COMMITTER_NAME="$GIT_AUTHOR_NAME"
export GIT_AUTHOR_EMAIL="$(git config --global --get user.email)"
export GIT_COMMITTER_EMAIL="$GIT_AUTHOR_EMAIL"

# vim: set filetype=zsh :
